{
  "info": {
    "name": "SDBP 022 - Assignment 02 (self-check)",
    "description": "Self-check suite for SDBP 022 Assignment 02.\n\nRun this against your own API before you submit. Every assertion here corresponds to a\nrequirement in the assignment brief. Passing it does not guarantee full marks - the\ngrading suite includes additional cases - but failing it means something is wrong.\n\nThe suite creates the rows it needs and deletes them afterwards, so you can run it as\noften as you like without resetting your database.\n\nStart your API first: dotnet run --project EmployeeManager.API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Dates are computed at run time so the collection does not expire.",
          "// BR-02 boundaries are relative to today in UTC, with the time of day discarded.",
          "const atMidnightUtc = (offsetDays) => {",
          "    const d = new Date();",
          "    d.setUTCDate(d.getUTCDate() + offsetDays);",
          "    return d.toISOString().split(\"T\")[0] + \"T00:00:00Z\";",
          "};",
          "",
          "pm.collectionVariables.set(\"today\", atMidnightUtc(0));",
          "pm.collectionVariables.set(\"plus31\", atMidnightUtc(31));",
          "pm.collectionVariables.set(\"plus32\", atMidnightUtc(32));",
          "pm.collectionVariables.set(\"minus60\", atMidnightUtc(-60));"
        ]
      }
    }
  ],
