        {
          "name": "Create assignment (valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"[Row3-CRUD] POST /api/assignment responds 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"[Row3-CRUD] POST returns a Location header\", function () {",
                  "    pm.expect(pm.response.headers.has(\"Location\"), \"Location header\").to.be.true;",
                  "});",
                  "pm.test(\"[Row3-CRUD] POST response body has the documented shape\", function () {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b).to.have.property(\"assignmentId\");",
                  "    pm.expect(b.employeeId, \"employeeId\").to.eql(51);",
                  "    pm.expect(b.departmentId, \"departmentId\").to.eql(7);",
                  "    pm.expect(b).to.have.property(\"assignmentDate\");",
                  "    pm.expect(b).to.have.property(\"status\");",
                  "});",
                  "pm.test(\"[Row3-CRUD] status is serialised as a name, not a number\", function () {",
                  "    pm.expect(pm.response.json().status, \"status\").to.be.a(\"string\");",
                  "});",
                  "pm.collectionVariables.set(\"crudId\", pm.response.json().assignmentId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
