{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // SQL Server LocalDB ships with every Visual Studio installation, so this works
    // on any machine with no configuration. To use a different server (SQLEXPRESS,
    // a named instance, Docker), override this key in appsettings.Development.json
    // or in user secrets. Do NOT hardcode your own machine name here - your
    // submission must run on the grading machine.
    "EmployeeDB": "Server=(localdb)\\MSSQLLocalDB;Database=db_employee;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True;"
  }
}
